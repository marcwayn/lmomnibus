{
  "name": "lmomnibus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler pages dev dist --port 8788",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest": "node scripts/ingest.ts",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lmomnibus --branch main"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}

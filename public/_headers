# Vite content-hashes everything under /assets, so a changed build always
# gets new filenames and these can be cached forever. HTML keeps Pages'
# default (revalidate every time), so a deploy is picked up immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Link-preview cards change with each catalog refresh; a day is plenty.
/og/*
  Cache-Control: public, max-age=86400

# Open data: refreshed with each catalog update.
/catalog.json
  Cache-Control: public, max-age=3600

# Open-weight architecture records: refreshed with the catalog.
/weights.json
  Cache-Control: public, max-age=3600
